rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A conta real do João tem outro UID que não o MrWON54... gravado nos
    // gastos; ela é reconhecida pelo e-mail (único por conta no Firebase Auth).
    // Precisa ser igual a EMAIL_JOAO em src/lib/identidade.ts.
    function isJoaoPorEmail() {
      return request.auth != null &&
        request.auth.token.email.lower() == 'jg.carvalhosilva@gmail.com';
    }

    function isCasal() {
      return request.auth != null &&
        (request.auth.uid in ['8WaJbLFwaXPzRGO30QYr3RjLL9E2', 'MrWON54UtMNsO6mLSTmShm3QiGz2'] ||
         isJoaoPorEmail());
    }

    // O perfil (/usuarios) fica sempre sob o UID "de dados", mesmo pro João por e-mail.
    function meuUidDeDados() {
      return isJoaoPorEmail() ? 'MrWON54UtMNsO6mLSTmShm3QiGz2' : request.auth.uid;
    }

    match /usuarios/{uid} {
      allow read: if isCasal();
      allow write: if isCasal() && meuUidDeDados() == uid;
    }

    match /tags/{tagId} {
      allow read, write: if isCasal();
    }

    match /gastos/{gastoId} {
      allow read, create: if isCasal();
      // Gasto já liquidado (regra 5.4) não muda mais: correção entra como gasto de ajuste.
      allow update: if isCasal() && resource.data.bloqueado_para_edicao != true;
      // Exclusão liberada pra qualquer gasto, inclusive já liquidado — em
      // troca, o cliente sempre grava uma linha em /logs antes de apagar.
      allow delete: if isCasal();
    }

    match /liquidacoes/{liquidacaoId} {
      // registro de auditoria: depois de criado, não muda nem apaga.
      allow read, create: if isCasal();
      allow update, delete: if false;
    }

    match /logs/{logId} {
      // log de alterações: só cria e lê, nunca edita ou apaga (senão não seria auditoria).
      allow read, create: if isCasal();
      allow update, delete: if false;
    }
  }
}
