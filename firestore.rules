rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isCasal() {
      return request.auth != null &&
        request.auth.uid in ['8WaJbLFwaXPzRGO30QYr3RjLL9E2', 'MrWON54UtMNsO6mLSTmShm3QiGz2'];
    }

    // Num gasto já bloqueado (regra 5.4), só o comprovante pode mudar —
    // ele não entra no cálculo do rateio, o resto (valor, pagador, status...)
    // exige um gasto de ajuste novo em vez de editar o histórico.
    function apenasComprovanteMudou() {
      let campos = request.resource.data.diff(resource.data).affectedKeys();
      return campos.hasOnly(['comprovante_url']);
    }

    match /usuarios/{uid} {
      allow read: if isCasal();
      allow write: if isCasal() && request.auth.uid == uid;
    }

    match /tags/{tagId} {
      allow read, write: if isCasal();
    }

    match /series_recorrentes/{serieId} {
      allow read, write: if isCasal();
    }

    match /gastos/{gastoId} {
      allow read, create: if isCasal();
      allow update: if isCasal() &&
        (resource.data.bloqueado_para_edicao != true || apenasComprovanteMudou());
      // Exclusão liberada pra qualquer gasto, inclusive já liquidado — em
      // troca, o cliente sempre grava uma linha em /logs antes de apagar.
      allow delete: if isCasal();
    }

    match /liquidacoes/{liquidacaoId} {
      // registro de auditoria: depois de criado, não muda nem apaga.
      allow read, create: if isCasal();
      allow update, delete: if false;
    }

    match /logs/{logId} {
      // log de alterações: só cria e lê, nunca edita ou apaga (senão não seria auditoria).
      allow read, create: if isCasal();
      allow update, delete: if false;
    }
  }
}
